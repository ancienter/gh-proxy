{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gh-proxy",
  "main": "src/index.ts",
  // 设置为当前日期
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  // 自定义域名，zone 必须在同一账号下
  "routes": [
    {
      "pattern": "gh-proxy.7s.pub",
      "custom_domain": true
    }
  ],
  // 静态资源（public/）；未命中资源的请求交给 Worker
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/*"]
  },
  // 让 Worker 尽量靠近上游（GitHub），降低回源 RTT
  "placement": {
    "mode": "smart"
  },
  // per-IP 限流：60 请求 / 60 秒（近似，见 README）；namespace_id 取账号内唯一值
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "20261013",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "vars": {
    // 主页地址，留空使用内置 public/ 资源；填外部地址则回源该地址
    "ASSET_URL": "",
    // 前缀，如果自定义路由为 example.com/gh/*，将 PREFIX 改为 '/gh/'
    "PREFIX": "/",
    // Docker Hub 只读镜像开关（'1' 开启 /v2 与 /token 路由）
    "DOCKER": "1",
    // Docker Hub 可缓存命名空间白名单（逗号分隔；空 = 不缓存任何 docker 内容）
    "DOCKER_CACHE": "library",
    // 分支文件使用 jsDelivr 镜像的开关，0 为关闭
    "JSDELIVR": "0",
    // 白名单，逗号分隔，路径中包含任一字符才通过，留空表示不限制
    "WHITE_LIST": ""
  },
  "observability": {
    "enabled": true
  }
}
